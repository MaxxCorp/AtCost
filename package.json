{
	"name": "@ac/monorepo",
	"private": true,
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"dev": "pnpm --filter \"./apps/**\" run dev",
		"build": "pnpm --filter \"./apps/**\" run build",
		"check": "pnpm --filter \"./apps/**\" run check",
		"db:generate": "pnpm --filter @ac/db run db:generate",
		"db:migrate": "pnpm --filter @ac/db run db:migrate",
		"db:push": "pnpm --filter @ac/db run db:push",
		"db:pull": "pnpm --filter @ac/db run db:pull",
		"db:check": "pnpm --filter @ac/db run db:check"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@7.0.2",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@rolldown/binding-win32-x64-msvc": "1.3.2",
		"@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
		"valibot": "^1.5.0"
	}
}