{
    "installCommand": "npm i -g --allow-scripts=pnpm pnpm@12.23.0 && npx pnpm install --no-frozen-lockfile",
    "buildCommand": "pnpm build",
    "outputDirectory": ".vercel/output",
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        }
    ]
}
