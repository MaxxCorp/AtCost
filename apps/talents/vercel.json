{
    "installCommand": "pnpm install --no-frozen-lockfile",
    "buildCommand": "pnpm build",
    "outputDirectory": ".vercel/output",
    "crons": [
        {
            "path": "/api/cron/sync-conditions",
            "schedule": "0 2 1 * *"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        }
    ]
}